ArchiveEntry "P1x: Organism 1 alone never produces Y (exact exponential biomass update)"
/* As P1, but the biomass reset Bio := Bio exp(Q_G) is exact: E tracks exp(Q_G) as the
   solution of E' = E * (growth rate), E = 1 at the start of the run, and Bio := Bio * E.
   (The same ODE a location contributes, so the Bio update is no longer over-approximated.) */
Definitions
  Real Vm = 20;
  Real Km = 1/20;
  Real dt = 1/10;
  Bool capok(Real Q, Real x, Real Bt) <-> ( Q*(Km+x) + Vm*x*dt >= 0 & Q*Bt + x >= 0 );
End.
ProgramVariables
  Real A, C, W, Y, Bio1, Q1A, Q1C, Q1G, xA, xC, E;
End.
Problem
  A >= 0 & C = 0 & Y = 0 & Bio1 > 0
  ->
  [{
     xA := A; xC := C;  Q1A := 0; Q1C := 0; Q1G := 0; E := 1;
     {A' = -Bio1, C' = -Bio1, Y' = Bio1, Q1A' = -1, Q1C' = -1, Q1G' = 1/10, E' = E/10}@invariant(E>0 & Bio1>0 & A = xA + Bio1*Q1A & C = xC + Bio1*Q1C & Y = -Bio1*Q1C & Q1C<=0);
     {A' = -3*Bio1, W' = 2*Bio1, Q1A' = -3, Q1G' = 1/10, E' = E/10}@invariant(E>0 & Bio1>0 & A = xA + Bio1*Q1A & C = xC + Bio1*Q1C & Y = -Bio1*Q1C & Q1C<=0);
     ?( capok(Q1A, xA, Bio1) & capok(Q1C, xC, Bio1) );
     Bio1 := Bio1*E;
   }*@invariant(C = 0 & Y = 0 & Bio1 > 0)
  ] Y = 0
End.
End.
