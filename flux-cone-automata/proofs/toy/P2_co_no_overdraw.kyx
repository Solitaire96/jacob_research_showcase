ArchiveEntry "P2: corrected co-culture bounds never overdraw a shared substrate"
/* Corrected stage-3 co-culture automaton (sequential product, nondeterministic dwell times).
   Bounds use the run-start snapshot and the TOTAL biomass Bio1 + Bio2.
   Claim: concentrations of A, B, C stay non-negative at every run boundary,
   whatever dwell times (flux strategy) each organism chooses. */
Definitions
  Real Vm = 20;
  Real Km = 1/20;
  Real dt = 1/10;
  Bool capok(Real Q, Real x, Real Bt) <-> ( Q*(Km+x) + Vm*x*dt >= 0 & Q*Bt + x >= 0 );
End.
ProgramVariables
  Real A, B, C, W, Y, Bio1, Bio2, Q1A, Q1C, Q1G, Q2A, Q2B, Q2G, xA, xB, xC;
End.
Problem
  A >= 0 & B >= 0 & C >= 0 & Bio1 > 0 & Bio2 > 0
  ->
  [{
     xA := A; xB := B; xC := C;
     Q1A := 0; Q1C := 0; Q1G := 0; Q2A := 0; Q2B := 0; Q2G := 0;
     {A' = -Bio1, C' = -Bio1, Y' = Bio1, Q1A' = -1, Q1C' = -1, Q1G' = 1/10};
     {A' = -3*Bio1, W' = 2*Bio1, Q1A' = -3, Q1G' = 1/10};
     {A' = -Bio2, B' = -Bio2, C' = Bio2, Q2A' = -1, Q2B' = -1, Q2G' = 1/50};
     ?( capok(Q1A, xA, Bio1+Bio2) & capok(Q1C, xC, Bio1+Bio2)
      & capok(Q2A, xA, Bio1+Bio2) & capok(Q2B, xB, Bio1+Bio2) );
     Bio1 := *; ?(Bio1 > 0); Bio2 := *; ?(Bio2 > 0);
   }*@invariant(A >= 0 & B >= 0 & C >= 0 & Bio1 > 0 & Bio2 > 0)
  ] (A >= 0 & B >= 0 & C >= 0)
End.
End.
