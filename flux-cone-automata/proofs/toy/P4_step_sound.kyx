ArchiveEntry "P4: one run of the co-culture automaton is one dFBA step (soundness, exact exponential)"
/* [run] : after any dwell times t1,t2,t3 >= 0 for which the closing guard holds, the new state is
   x + Bio * T * (sum_k t_k b_k)  and  Bio * exp(Q_G) -- i.e. the dFBA update for v = sum_k (t_k/dt) b_k,
   a non-negative combination of the generators (so v is in F_irr), and v meets the bounds on the snapshot x. */
Definitions
  Real Vm = 20;
  Real Km = 1/20;
  Real dt = 1/10;
  Bool capok(Real Q, Real x, Real Bt) <-> ( Q*(Km+x) + Vm*x*dt >= 0 & Q*Bt + x >= 0 );
End.
ProgramVariables
  Real A, B, C, W, Y, Bio1, Bio2, Q1A, Q1C, Q1G, Q2A, Q2B, Q2G, xA, xB, xC, E1, E2, t1, t2, t3, y0, w0, b1, b2;
End.
Problem
  A >= 0 & B >= 0 & C >= 0 & Bio1 > 0 & Bio2 > 0
  ->
  [{
     xA := A; xB := B; xC := C; y0 := Y; w0 := W; b1 := Bio1; b2 := Bio2;
     Q1A := 0; Q1C := 0; Q1G := 0; Q2A := 0; Q2B := 0; Q2G := 0; E1 := 1; E2 := 1; t1 := 0; t2 := 0; t3 := 0;
     {A' = -Bio1, C' = -Bio1, Y' = Bio1, Q1A' = -1, Q1C' = -1, Q1G' = 1/10, E1' = E1/10, t1' = 1}@invariant(E1>0 & E2>0 & Bio1>0 & Bio2>0 & t1>=0 & t2>=0 & t3>=0 & Q1A = -(t1+3*t2) & Q1C = -t1 & Q2A = -t3 & Q2B = -t3 & A = xA - Bio1*(t1+3*t2) - Bio2*t3 & B = xB - Bio2*t3 & C = xC - Bio1*t1 + Bio2*t3 & Y = y0 + Bio1*t1 & W = w0 + 2*Bio1*t2 & Q1G = (t1+t2)/10 & Q2G = t3/50 & Bio1 = b1 & Bio2 = b2);
     {A' = -3*Bio1, W' = 2*Bio1, Q1A' = -3, Q1G' = 1/10, E1' = E1/10, t2' = 1}@invariant(E1>0 & E2>0 & Bio1>0 & Bio2>0 & t1>=0 & t2>=0 & t3>=0 & Q1A = -(t1+3*t2) & Q1C = -t1 & Q2A = -t3 & Q2B = -t3 & A = xA - Bio1*(t1+3*t2) - Bio2*t3 & B = xB - Bio2*t3 & C = xC - Bio1*t1 + Bio2*t3 & Y = y0 + Bio1*t1 & W = w0 + 2*Bio1*t2 & Q1G = (t1+t2)/10 & Q2G = t3/50 & Bio1 = b1 & Bio2 = b2);
     {A' = -Bio2, B' = -Bio2, C' = Bio2, Q2A' = -1, Q2B' = -1, Q2G' = 1/50, E2' = E2/50, t3' = 1}@invariant(E1>0 & E2>0 & Bio1>0 & Bio2>0 & t1>=0 & t2>=0 & t3>=0 & Q1A = -(t1+3*t2) & Q1C = -t1 & Q2A = -t3 & Q2B = -t3 & A = xA - Bio1*(t1+3*t2) - Bio2*t3 & B = xB - Bio2*t3 & C = xC - Bio1*t1 + Bio2*t3 & Y = y0 + Bio1*t1 & W = w0 + 2*Bio1*t2 & Q1G = (t1+t2)/10 & Q2G = t3/50 & Bio1 = b1 & Bio2 = b2);
     ?( capok(Q1A, xA, Bio1+Bio2) & capok(Q1C, xC, Bio1+Bio2) & capok(Q2A, xA, Bio1+Bio2) & capok(Q2B, xB, Bio1+Bio2) );
     Bio1 := Bio1*E1; Bio2 := Bio2*E2;
   }]
  ( t1>=0 & t2>=0 & t3>=0
  & capok(-(t1+3*t2), xA, b1+b2) & capok(-t1, xC, b1+b2) & capok(-t3, xA, b1+b2) & capok(-t3, xB, b1+b2)
  & A = xA - b1*(t1+3*t2) - b2*t3 & B = xB - b2*t3 & C = xC - b1*t1 + b2*t3
  & Y = y0 + b1*t1 & W = w0 + 2*b1*t2 & Q1G = (t1+t2)/10 & Q2G = t3/50
  & Bio1 = b1*E1 & Bio2 = b2*E2 & E1 > 0 & E2 > 0 )
End.
End.
