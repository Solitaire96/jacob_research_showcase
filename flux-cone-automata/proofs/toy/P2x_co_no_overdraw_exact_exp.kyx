ArchiveEntry "P2x: corrected co-culture bounds never overdraw a shared substrate (exact exponential biomass update)"
/* As P2, with the biomass reset exact: E1, E2 track exp(Q1G), exp(Q2G) as solutions of E' = E*rate. */
Definitions
  Real Vm = 20;
  Real Km = 1/20;
  Real dt = 1/10;
  Bool capok(Real Q, Real x, Real Bt) <-> ( Q*(Km+x) + Vm*x*dt >= 0 & Q*Bt + x >= 0 );
End.
ProgramVariables
  Real A, B, C, W, Y, Bio1, Bio2, Q1A, Q1C, Q1G, Q2A, Q2B, Q2G, xA, xB, xC, E1, E2;
End.
Problem
  A >= 0 & B >= 0 & C >= 0 & Bio1 > 0 & Bio2 > 0
  ->
  [{
     xA := A; xB := B; xC := C;
     Q1A := 0; Q1C := 0; Q1G := 0; Q2A := 0; Q2B := 0; Q2G := 0; E1 := 1; E2 := 1;
     {A' = -Bio1, C' = -Bio1, Y' = Bio1, Q1A' = -1, Q1C' = -1, Q1G' = 1/10, E1' = E1/10}@invariant(E1>0 & E2>0 & Bio1>0 & Bio2>0 & A = xA + Bio1*Q1A + Bio2*Q2A & B = xB + Bio2*Q2B & C = xC + Bio1*Q1C - Bio2*Q2B & Q1A<=0 & Q1C<=0 & Q2A<=0 & Q2B<=0);
     {A' = -3*Bio1, W' = 2*Bio1, Q1A' = -3, Q1G' = 1/10, E1' = E1/10}@invariant(E1>0 & E2>0 & Bio1>0 & Bio2>0 & A = xA + Bio1*Q1A + Bio2*Q2A & B = xB + Bio2*Q2B & C = xC + Bio1*Q1C - Bio2*Q2B & Q1A<=0 & Q1C<=0 & Q2A<=0 & Q2B<=0);
     {A' = -Bio2, B' = -Bio2, C' = Bio2, Q2A' = -1, Q2B' = -1, Q2G' = 1/50, E2' = E2/50}@invariant(E1>0 & E2>0 & Bio1>0 & Bio2>0 & A = xA + Bio1*Q1A + Bio2*Q2A & B = xB + Bio2*Q2B & C = xC + Bio1*Q1C - Bio2*Q2B & Q1A<=0 & Q1C<=0 & Q2A<=0 & Q2B<=0);
     ?( capok(Q1A, xA, Bio1+Bio2) & capok(Q1C, xC, Bio1+Bio2)
      & capok(Q2A, xA, Bio1+Bio2) & capok(Q2B, xB, Bio1+Bio2) );
     Bio1 := Bio1*E1; Bio2 := Bio2*E2;
   }*@invariant(A >= 0 & B >= 0 & C >= 0 & Bio1 > 0 & Bio2 > 0)
  ] (A >= 0 & B >= 0 & C >= 0)
End.
End.
