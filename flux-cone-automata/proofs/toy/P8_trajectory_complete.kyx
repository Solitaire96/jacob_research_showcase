/* P8 / P8g: whole-trajectory completeness (the "supseteq" direction of Theorem 1) for the reference co-culture.
   Generated by gen_P8.py (the tactics repeat the program text verbatim in their cut formulas).

   dFBA copy D (one dFBA step of the copy state Ac..Bio2c, pc):
     choose a dwell vector s = (s1,s2,s3) >= 0, i.e. the flux v = sum_k (s_k/dt) b_k of the flux cone,
     test that its uptakes meet the Michaelis-Menten / availability bounds at the copy's CURRENT state
     (capok, total biomass Bio1c+Bio2c, exactly P5's precondition), and apply the dFBA update:
     medium x + dt*Bio*T*v for A, B, C, W, Y and the exact biomass update Bio := Bio*exp(dt*v_growth)
     (kyx.math.exp, KeYmaera X's built-in exponential), dFBA time pc := pc + dt.
   Automaton run H (one loop iteration of P7's automaton, unchanged: snapshots, Q := 0, E := 1, t := 0;
     locations L11, L12, L21 as ODEs of unconstrained duration with E_o' = g_o E_o; the closing check on the
     snapshot with total biomass; resets Bio := Bio*E, p := p + dt).  The braces only group the run for the
     tactic; the E_o' equation is listed first in each ODE (order inside an ODE is immaterial).
   P8 (dL):  for every number of dFBA steps, the automaton has SOME run (H*) that ends, at a step boundary,
     in exactly the copy's state, after the same number of closing transitions (p = pc).
   P8g (dGL, hybrid game; H^@ = the automaton's choices are resolved by the prover):  the automaton can follow
     every dFBA trajectory step by step: after every dFBA step the state after the matching closing
     transition equals the dFBA state.  This is the sequence form of Theorem 1, and the realization is online.
   Both proofs reuse the same one-step lemma, proved inside the tactic as three cuts: <H_pre>(t = s)
   (diamond, the ghosts E_o removed by dDDG), [H_pre](t = s -> medium/Q_G/positivity) (box, dI), and
   [H_pre](E_o = exp(Q_oG)) (box, Darboux dbx), combined with Kd2. */

ArchiveEntry "P8: every dFBA trajectory is realised by a run of the co-culture automaton (completeness, endpoint form)"
/* Endpoint form in differential dynamic logic: [dFBA copy*] <automaton*> (state = copy). */
Definitions
  import kyx.math.exp;
  Real Vm = 20;
  Real Km = 1/20;
  Real dt = 1/10;
  Bool capok(Real Q, Real x, Real Bt) <-> ( Q*(Km+x) + Vm*x*dt >= 0 & Q*Bt + x >= 0 );
End.
ProgramVariables
  Real A, B, C, W, Y, Bio1, Bio2, p, Q1A, Q1C, Q1G, Q2A, Q2B, Q2G, xA, xB, xC, E1, E2, t1, t2, t3,
       Ac, Bc, Cc, Wc, Yc, Bio1c, Bio2c, pc, s1, s2, s3;
End.
Problem
  A >= 0 & B >= 0 & C >= 0 & Bio1 > 0 & Bio2 > 0
  -> [ Ac := A; Bc := B; Cc := C; Wc := W; Yc := Y; Bio1c := Bio1; Bio2c := Bio2; pc := p;
       { s1 := *; s2 := *; s3 := *; ?(s1 >= 0 & s2 >= 0 & s3 >= 0 & capok(-(s1+3*s2), Ac, Bio1c+Bio2c) & capok(-s1, Cc, Bio1c+Bio2c) & capok(-s3, Ac, Bio1c+Bio2c) & capok(-s3, Bc, Bio1c+Bio2c)); Ac := Ac - Bio1c*(s1+3*s2) - Bio2c*s3; Bc := Bc - Bio2c*s3; Cc := Cc - Bio1c*s1 + Bio2c*s3; Yc := Yc + Bio1c*s1; Wc := Wc + 2*Bio1c*s2; Bio1c := Bio1c*exp((s1+s2)/10); Bio2c := Bio2c*exp(s3/50); pc := pc + dt; }*
     ] <{{ { { xA := A; xB := B; xC := C; Q1A := 0; Q1C := 0; Q1G := 0; Q2A := 0; Q2B := 0; Q2G := 0; E1 := 1; E2 := 1; t1 := 0; t2 := 0; t3 := 0; {E1' = E1/10, A' = -Bio1, C' = -Bio1, Y' = Bio1, Q1A' = -1, Q1C' = -1, Q1G' = 1/10, t1' = 1} } { {E1' = E1/10, A' = -3*Bio1, W' = 2*Bio1, Q1A' = -3, Q1G' = 1/10, t2' = 1}; {E2' = E2/50, A' = -Bio2, B' = -Bio2, C' = Bio2, Q2A' = -1, Q2B' = -1, Q2G' = 1/50, t3' = 1}; ?( capok(Q1A, xA, Bio1+Bio2) & capok(Q1C, xC, Bio1+Bio2) & capok(Q2A, xA, Bio1+Bio2) & capok(Q2B, xB, Bio1+Bio2) ); } } { Bio1 := Bio1*E1; Bio2 := Bio2*E2; p := p + dt; } }}*>(A = Ac & B = Bc & C = Cc & W = Wc & Y = Yc & Bio1 = Bio1c & Bio2 = Bio2c & p = pc)
End.
Tactic "loop over the dFBA copy; <**> iterate, Kd2, <*> approx; one-step lemma by cuts"
  implyR(1); chase(1); (allR(1) | implyR(1))*; loop("<{{ { { xA := A; xB := B; xC := C; Q1A := 0; Q1C := 0; Q1G := 0; Q2A := 0; Q2B := 0; Q2G := 0; E1 := 1; E2 := 1; t1 := 0; t2 := 0; t3 := 0; {E1' = E1/10, A' = -Bio1, C' = -Bio1, Y' = Bio1, Q1A' = -1, Q1C' = -1, Q1G' = 1/10, t1' = 1} } { {E1' = E1/10, A' = -3*Bio1, W' = 2*Bio1, Q1A' = -3, Q1G' = 1/10, t2' = 1}; {E2' = E2/50, A' = -Bio2, B' = -Bio2, C' = Bio2, Q2A' = -1, Q2B' = -1, Q2G' = 1/50, t3' = 1}; ?( capok(Q1A, xA, Bio1+Bio2) & capok(Q1C, xC, Bio1+Bio2) & capok(Q2A, xA, Bio1+Bio2) & capok(Q2B, xB, Bio1+Bio2) ); } } { Bio1 := Bio1*E1; Bio2 := Bio2*E2; p := p + dt; } }}*>(A = Ac & B = Bc & C = Cc & W = Wc & Y = Yc & Bio1 = Bio1c & Bio2 = Bio2c & p = pc & A >= 0 & B >= 0 & C >= 0 & Bio1 > 0 & Bio2 > 0)", 1); <( iterated(1); orR(1); hideR(2); QE, cohideOnlyL(-1); mond; prop, composeb(1); randomb(1); allR(1); composeb(1); randomb(1); allR(1); composeb(1); randomb(1); allR(1); composeb(1); testb(1); implyR(1); composeb(1); composeb(1.1); composeb(1.1.1); composeb(1.1.1.1); composeb(1.1.1.1.1); composeb(1.1.1.1.1.1); composeb(1.1.1.1.1.1.1); assignb(1.1.1.1.1.1.1.1); assignb(1.1.1.1.1.1.1); assignb(1.1.1.1.1.1); assignb(1.1.1.1.1); assignb(1.1.1.1); assignb(1.1.1); assignb(1.1); assignb(1); useAt("<**> iterate iterate", "1", 1); composed(1); cut("[{{ { { xA := A; xB := B; xC := C; Q1A := 0; Q1C := 0; Q1G := 0; Q2A := 0; Q2B := 0; Q2G := 0; E1 := 1; E2 := 1; t1 := 0; t2 := 0; t3 := 0; {E1' = E1/10, A' = -Bio1, C' = -Bio1, Y' = Bio1, Q1A' = -1, Q1C' = -1, Q1G' = 1/10, t1' = 1} } { {E1' = E1/10, A' = -3*Bio1, W' = 2*Bio1, Q1A' = -3, Q1G' = 1/10, t2' = 1}; {E2' = E2/50, A' = -Bio2, B' = -Bio2, C' = Bio2, Q2A' = -1, Q2B' = -1, Q2G' = 1/50, t3' = 1}; ?( capok(Q1A, xA, Bio1+Bio2) & capok(Q1C, xC, Bio1+Bio2) & capok(Q2A, xA, Bio1+Bio2) & capok(Q2B, xB, Bio1+Bio2) ); } } { Bio1 := Bio1*E1; Bio2 := Bio2*E2; p := p + dt; } }}*](s1 >= 0 & s2 >= 0 & s3 >= 0 & capok(-(s1+3*s2), Ac, Bio1c+Bio2c) & capok(-s1, Cc, Bio1c+Bio2c) & capok(-s3, Ac, Bio1c+Bio2c) & capok(-s3, Bc, Bio1c+Bio2c))"); <( cut("<{{ { { xA := A; xB := B; xC := C; Q1A := 0; Q1C := 0; Q1G := 0; Q2A := 0; Q2B := 0; Q2G := 0; E1 := 1; E2 := 1; t1 := 0; t2 := 0; t3 := 0; {E1' = E1/10, A' = -Bio1, C' = -Bio1, Y' = Bio1, Q1A' = -1, Q1C' = -1, Q1G' = 1/10, t1' = 1} } { {E1' = E1/10, A' = -3*Bio1, W' = 2*Bio1, Q1A' = -3, Q1G' = 1/10, t2' = 1}; {E2' = E2/50, A' = -Bio2, B' = -Bio2, C' = Bio2, Q2A' = -1, Q2B' = -1, Q2G' = 1/50, t3' = 1}; ?( capok(Q1A, xA, Bio1+Bio2) & capok(Q1C, xC, Bio1+Bio2) & capok(Q2A, xA, Bio1+Bio2) & capok(Q2B, xB, Bio1+Bio2) ); } } { Bio1 := Bio1*E1; Bio2 := Bio2*E2; p := p + dt; } }}*>((s1 >= 0 & s2 >= 0 & s3 >= 0 & capok(-(s1+3*s2), Ac, Bio1c+Bio2c) & capok(-s1, Cc, Bio1c+Bio2c) & capok(-s3, Ac, Bio1c+Bio2c) & capok(-s3, Bc, Bio1c+Bio2c)) & (A = Ac & B = Bc & C = Cc & W = Wc & Y = Yc & Bio1 = Bio1c & Bio2 = Bio2c & p = pc & A >= 0 & B >= 0 & C >= 0 & Bio1 > 0 & Bio2 > 0))"); <( cohideOnlyL('Llast); mond; useAt("<*> approx", "1", 1); composed(1); cut("(s1 >= 0 & s2 >= 0 & s3 >= 0 & capok(-(s1+3*s2), Ac, Bio1c+Bio2c) & capok(-s1, Cc, Bio1c+Bio2c) & capok(-s3, Ac, Bio1c+Bio2c) & capok(-s3, Bc, Bio1c+Bio2c)) & (A = Ac & B = Bc & C = Cc & W = Wc & Y = Yc & Bio1 = Bio1c & Bio2 = Bio2c & p = pc & A >= 0 & B >= 0 & C >= 0 & Bio1 > 0 & Bio2 > 0) -> [{ { xA := A; xB := B; xC := C; Q1A := 0; Q1C := 0; Q1G := 0; Q2A := 0; Q2B := 0; Q2G := 0; E1 := 1; E2 := 1; t1 := 0; t2 := 0; t3 := 0; {E1' = E1/10, A' = -Bio1, C' = -Bio1, Y' = Bio1, Q1A' = -1, Q1C' = -1, Q1G' = 1/10, t1' = 1} } { {E1' = E1/10, A' = -3*Bio1, W' = 2*Bio1, Q1A' = -3, Q1G' = 1/10, t2' = 1}; {E2' = E2/50, A' = -Bio2, B' = -Bio2, C' = Bio2, Q2A' = -1, Q2B' = -1, Q2G' = 1/50, t3' = 1}; ?( capok(Q1A, xA, Bio1+Bio2) & capok(Q1C, xC, Bio1+Bio2) & capok(Q2A, xA, Bio1+Bio2) & capok(Q2B, xB, Bio1+Bio2) ); } }](t1 = s1 & t2 = s2 & t3 = s3 -> Q1G = (s1+s2)/10 & Q2G = s3/50 & Bio1 = Bio1c & Bio2 = Bio2c & A = Ac - Bio1c*(s1+3*s2) - Bio2c*s3 & B = Bc - Bio2c*s3 & C = Cc - Bio1c*s1 + Bio2c*s3 & W = Wc + 2*Bio1c*s2 & Y = Yc + Bio1c*s1 & p + dt = pc + dt & A >= 0 & B >= 0 & C >= 0 & Bio1*E1 > 0 & Bio2*E2 > 0)"); <( implyL('Llast); <( hideR(1); prop, cut("(s1 >= 0 & s2 >= 0 & s3 >= 0 & capok(-(s1+3*s2), Ac, Bio1c+Bio2c) & capok(-s1, Cc, Bio1c+Bio2c) & capok(-s3, Ac, Bio1c+Bio2c) & capok(-s3, Bc, Bio1c+Bio2c)) & (A = Ac & B = Bc & C = Cc & W = Wc & Y = Yc & Bio1 = Bio1c & Bio2 = Bio2c & p = pc & A >= 0 & B >= 0 & C >= 0 & Bio1 > 0 & Bio2 > 0) -> [{ { xA := A; xB := B; xC := C; Q1A := 0; Q1C := 0; Q1G := 0; Q2A := 0; Q2B := 0; Q2G := 0; E1 := 1; E2 := 1; t1 := 0; t2 := 0; t3 := 0; {E1' = E1/10, A' = -Bio1, C' = -Bio1, Y' = Bio1, Q1A' = -1, Q1C' = -1, Q1G' = 1/10, t1' = 1} } { {E1' = E1/10, A' = -3*Bio1, W' = 2*Bio1, Q1A' = -3, Q1G' = 1/10, t2' = 1}; {E2' = E2/50, A' = -Bio2, B' = -Bio2, C' = Bio2, Q2A' = -1, Q2B' = -1, Q2G' = 1/50, t3' = 1}; ?( capok(Q1A, xA, Bio1+Bio2) & capok(Q1C, xC, Bio1+Bio2) & capok(Q2A, xA, Bio1+Bio2) & capok(Q2B, xB, Bio1+Bio2) ); } }](E1 - exp(Q1G) = 0 & E2 - exp(Q2G) = 0)"); <( implyL('Llast); <( hideR(1); prop, cut("(s1 >= 0 & s2 >= 0 & s3 >= 0 & capok(-(s1+3*s2), Ac, Bio1c+Bio2c) & capok(-s1, Cc, Bio1c+Bio2c) & capok(-s3, Ac, Bio1c+Bio2c) & capok(-s3, Bc, Bio1c+Bio2c)) & (A = Ac & B = Bc & C = Cc & W = Wc & Y = Yc & Bio1 = Bio1c & Bio2 = Bio2c & p = pc & A >= 0 & B >= 0 & C >= 0 & Bio1 > 0 & Bio2 > 0) -> <{ { xA := A; xB := B; xC := C; Q1A := 0; Q1C := 0; Q1G := 0; Q2A := 0; Q2B := 0; Q2G := 0; E1 := 1; E2 := 1; t1 := 0; t2 := 0; t3 := 0; {E1' = E1/10, A' = -Bio1, C' = -Bio1, Y' = Bio1, Q1A' = -1, Q1C' = -1, Q1G' = 1/10, t1' = 1} } { {E1' = E1/10, A' = -3*Bio1, W' = 2*Bio1, Q1A' = -3, Q1G' = 1/10, t2' = 1}; {E2' = E2/50, A' = -Bio2, B' = -Bio2, C' = Bio2, Q2A' = -1, Q2B' = -1, Q2G' = 1/50, t3' = 1}; ?( capok(Q1A, xA, Bio1+Bio2) & capok(Q1C, xC, Bio1+Bio2) & capok(Q2A, xA, Bio1+Bio2) & capok(Q2B, xB, Bio1+Bio2) ); } }>(t1 = s1 & t2 = s2 & t3 = s3)"); <( implyL('Llast); <( hideR(1); prop, cut("<{ { xA := A; xB 