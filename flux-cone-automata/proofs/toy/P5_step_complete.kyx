ArchiveEntry "P5: every feasible flux is realised by one run (completeness)"
/* For every dwell-time vector s = (s1,s2,s3) >= 0 (i.e. every flux v = sum (s_k/dt) b_k of the cone) whose
   bounds hold on the run-start state, SOME execution of the run program dwells exactly s_k in each
   location, passes the closing check, and ends in the dFBA successor state: medium A, B, C, W, Y and the
   growth exponents Q1G = dt*v_growth1, Q2G = dt*v_growth2 used by the biomass reset Bio := Bio*e^QG.
   (Strengthened 2026-10-22: the earlier version stated only A, B, C.) */
Definitions
  Real Vm = 20;
  Real Km = 1/20;
  Real dt = 1/10;
  Bool capok(Real Q, Real x, Real Bt) <-> ( Q*(Km+x) + Vm*x*dt >= 0 & Q*Bt + x >= 0 );
End.
ProgramVariables
  Real A, B, C, W, Y, Bio1, Bio2, Q1A, Q1C, Q2A, Q2B, Q1G, Q2G, xA, xB, xC, xW, xY, t1, t2, t3, s1, s2, s3;
End.
Problem
  A >= 0 & B >= 0 & C >= 0 & Bio1 > 0 & Bio2 > 0 & s1 >= 0 & s2 >= 0 & s3 >= 0
  & capok(-(s1+3*s2), A, Bio1+Bio2) & capok(-s1, C, Bio1+Bio2) & capok(-s3, A, Bio1+Bio2) & capok(-s3, B, Bio1+Bio2)
  ->
  <{
     xA := A; xB := B; xC := C; xW := W; xY := Y; Q1G := 0; Q2G := 0;
     Q1A := 0; Q1C := 0; Q2A := 0; Q2B := 0; t1 := 0; t2 := 0; t3 := 0;
     {A' = -Bio1, C' = -Bio1, Y' = Bio1, Q1A' = -1, Q1C' = -1, Q1G' = 1/10, t1' = 1};
     {A' = -3*Bio1, W' = 2*Bio1, Q1A' = -3, Q1G' = 1/10, t2' = 1};
     {A' = -Bio2, B' = -Bio2, C' = Bio2, Q2A' = -1, Q2B' = -1, Q2G' = 1/50, t3' = 1};
     ?( capok(Q1A, xA, Bio1+Bio2) & capok(Q1C, xC, Bio1+Bio2) & capok(Q2A, xA, Bio1+Bio2) & capok(Q2B, xB, Bio1+Bio2) );
     ?( t1 = s1 & t2 = s2 & t3 = s3 );
   }>
  ( A = xA - Bio1*(s1+3*s2) - Bio2*s3 & B = xB - Bio2*s3 & C = xC - Bio1*s1 + Bio2*s3
    & Y = xY + Bio1*s1 & W = xW + 2*Bio1*s2 & Q1G = (s1+s2)/10 & Q2G = s3/50 )
End.
Tactic "witness: dwell exactly s_k in location k"
  expandAllDefs; implyR(1); chase(1); (allR(1) | implyR(1))*;
  solve(1); existsR("s1",1); andR(1); <(QE, (allR(1) | implyR(1))*;
  solve(1); existsR("s2",1); andR(1); <(QE, (allR(1) | implyR(1))*;
  solve(1); existsR("s3",1); andR(1); <(QE, (allR(1) | implyR(1))*;
  chase(1); QE)))
End.
End.
