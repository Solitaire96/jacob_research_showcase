ArchiveEntry "P3: the co-culture can raise Y above the detection threshold within two dFBA steps"
/* Corrected co-culture step (as in P2).  Start: Chiu medium A = B = 10, C = W = Y = 0,
   Bio1 = Bio2 = 0.01.  Claim: some strategy satisfying every closing check reaches Y > eps
   (eps = 1e-3) after two steps.  The biomass reset Bio := Bio * exp(Q_G) is handled soundly
   for a diamond by quantifying UNIVERSALLY over every E in [1+Q, 1/(1-Q)], an interval that
   contains exp(Q) for 0 <= Q < 1. */
Definitions
  Real Vm = 20;
  Real Km = 1/20;
  Real dt = 1/10;
  Real eps = 1/1000;
  Bool capok(Real Q, Real x, Real Bt) <-> ( Q*(Km+x) + Vm*x*dt >= 0 & Q*Bt + x >= 0 );
  Bool expbd(Real E, Real Q) <-> ( E >= 1 + Q & (Q < 1 -> E*(1-Q) <= 1) );
  HP step ::= {
     xA := A; xB := B; xC := C;
     Q1A := 0; Q1C := 0; Q1G := 0; Q2A := 0; Q2B := 0; Q2G := 0;
     {A' = -Bio1, C' = -Bio1, Y' = Bio1, Q1A' = -1, Q1C' = -1, Q1G' = 1/10};
     {A' = -3*Bio1, W' = 2*Bio1, Q1A' = -3, Q1G' = 1/10};
     {A' = -Bio2, B' = -Bio2, C' = Bio2, Q2A' = -1, Q2B' = -1, Q2G' = 1/50};
     ?( capok(Q1A, xA, Bio1+Bio2) & capok(Q1C, xC, Bio1+Bio2)
      & capok(Q2A, xA, Bio1+Bio2) & capok(Q2B, xB, Bio1+Bio2) );
  };
End.
ProgramVariables
  Real A, B, C, W, Y, Bio1, Bio2, Q1A, Q1C, Q1G, Q2A, Q2B, Q2G, xA, xB, xC, E1, E2;
End.
Problem
  A = 10 & B = 10 & C = 0 & W = 0 & Y = 0 & Bio1 = 1/100 & Bio2 = 1/100
  ->
  < step; >
  [ E1 := *; E2 := *; ?(expbd(E1, Q1G) & expbd(E2, Q2G)); ]
  < Bio1 := Bio1*E1; Bio2 := Bio2*E2; step; > Y > eps
End.
Tactic "witness: step 1 org 2 dwells 1 in L21; step 2 org 1 dwells 3/10 in L11"
  expandAllDefs; implyR(1); chase(1); (allR(1) | implyR(1))*;
  solve(1); existsR("0",1); andR(1); <(QE, (allR(1) | implyR(1))*;
  solve(1); existsR("0",1); andR(1); <(QE, (allR(1) | implyR(1))*;
  solve(1); existsR("1",1); andR(1); <(QE, (allR(1) | implyR(1))*;
  andR(1); <(QE, chase(1); (allR(1) | implyR(1))*;
  solve(1); existsR("3/10",1); andR(1); <(QE, (allR(1) | implyR(1))*;
  solve(1); existsR("0",1); andR(1); <(QE, (allR(1) | implyR(1))*;
  solve(1); existsR("0",1); andR(1); <(QE, (allR(1) | implyR(1))*; QE)))))))
End.
End.
