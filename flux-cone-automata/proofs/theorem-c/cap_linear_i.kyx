ArchiveEntry "ThmC-i linear: G >= gam, hence B <= P0 - Y*gam = b, along every piecewise-constant strategy, cap linear k*B*G"
/* Generated by gen_caps.py.  Branch (i) (c nondecreasing in B), twin argument: u <= c(B,G) <= c(P0-Y*G, G) =: phi(G)
   because B <= P0 - Y*G (P <= P0).  Ghost gam is the greedy glucose, gam' = -phi(gam), polynomialized with
   s = 1/Dn(gam); sG = 1/Dn(G) is a ghost for the cofactor's denominator; greedy biomass is P0 - Y*gam.
   Comparison: dbx on G - gam with cofactor -(phi(G)-phi(gam))/(G-gam) = -Q*s*sG (exact divided difference). */
ProgramVariables
  Real B; Real G; Real gam; Real u; Real g; Real P0; Real k; Real Y;
End.
Problem
  k>0 & Y>0
  & B >= 0 & G >= 0 & B + Y*G = P0 & gam = G
  ->
  [{ u := *; g := *; ?(0<=u & u*(1) <= B*(G*k) & 0<=g & g<=Y*u);
     {B' = g, G' = -u, gam' = -P0*gam*k + Y*gam^2*k & G>=0 & u*(1) <= B*(G*k)}
   }*
  ] (B <= P0 - Y*gam & B >= 0 & G >= 0 & B + Y*G <= P0 & G >= gam & gam >= 0)
End.
Tactic "dbx comparison (generated)"
  implyR(1); andL('L)*;
  loop("B >= 0 & G >= 0 & B + Y*G <= P0 & G >= gam & gam >= 0", 1); <(
    QE,
    QE,
    unfold;
    dC("gam >= 0", 1); <( dC("B + Y*G <= P0", 1); <( dC("B >= 0", 1); <( dC("u*(1) <= (-G^2*Y*k + G*P0*k)", 1); <( dC("(G*Y*k - P0*k + Y*gam*k)*(G-gam) = (P0*gam*k - Y*gam^2*k) - (-G^2*Y*k + G*P0*k)", 1); <( dC("-u + (P0*gam*k - Y*gam^2*k) - (G*Y*k - P0*k + Y*gam*k)*(G-gam) >= 0", 1); <( dC("G - gam >= 0", 1); <( dW(1); QE, hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="gam >= 0"); hideL('L=="u*(1) <= B*(G*k)"); dbx("G*Y*k - P0*k + Y*gam*k", 1); doall(allR(1)*; implyR(1); andL('L)*; cohideOnlyL('L=="-u + (P0*gam*k - Y*gam^2*k) - (G*Y*k - P0*k + Y*gam*k)*(G-gam) >= 0"); QE) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="G >= gam"); hideL('L=="gam >= 0"); hideL('L=="u*(1) <= B*(G*k)"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; cut("(G*Y*k - P0*k + Y*gam*k)*(G-gam) = (P0*gam*k - Y*gam^2*k) - (-G^2*Y*k + G*P0*k)"); <( allL2R('Llast); QE, hideR(1); QE ) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="G >= gam"); hideL('L=="gam >= 0"); hideL('L=="u*(1) <= B*(G*k)"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="G >= gam"); hideL('L=="gam >= 0"); hideL('L=="u*(1) <= B*(G*k)"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), dI(1) ), dI(1) ), dbx("-P0*k + Y*gam*k", 1) )
  )
End.
End.
