ArchiveEntry "ThmC-ii linear: B <= b along every piecewise-constant strategy, cap linear k*B*G"
/* Generated by gen_caps.py.  Branch (ii) (c nondecreasing in G).  Ghost b is the greedy biomass,
   b' = h(b) = Y*c(b,(P0-b)/Y) = b*Nt(b)/Dt(b), polynomialized with r = 1/Dt(b); rB = 1/Dt(B) is a ghost for the
   cofactor's denominator.  Comparison: dbx on b - B with cofactor q = (h(b)-h(B))/(b-B) = Mt*r*rB (exact divided
   difference).  The cap constraint u <= c(B,G) is written u*Dn(G) <= B*N(G) (Dn > 0 on G >= 0).
   The postcondition exports the loop invariant (needed by the ghost-existence glue). */
ProgramVariables
  Real B; Real G; Real b; Real u; Real g; Real P0; Real k; Real Y;
End.
Problem
  k>0 & Y>0
  & B >= 0 & G >= 0 & B + Y*G = P0 & b = B
  ->
  [{ u := *; g := *; ?(0<=u & u*(1) <= B*(G*k) & 0<=g & g<=Y*u);
     {B' = g, G' = -u, b' = P0*b*k - b^2*k & G>=0 & u*(1) <= B*(G*k)}
   }*
  ] (B >= 0 & G >= 0 & B + Y*G <= P0 & B <= b & b <= P0)
End.
Tactic "dbx comparison (generated)"
  implyR(1); andL('L)*;
  loop("B >= 0 & G >= 0 & B + Y*G <= P0 & B <= b & b <= P0", 1); <(
    QE,
    QE,
    unfold;
    dC("P0 - b >= 0", 1); <( dC("B + Y*G <= P0", 1); <( dC("B >= 0", 1); <( dC("Y*u*(1) <= B*(-B*k + P0*k)", 1); <( dC("g*(1) <= B*(-B*k + P0*k)", 1); <( dC("(-B*k + P0*k - b*k)*(b-B) = (P0*b*k - b^2*k) - (-B^2*k + B*P0*k)", 1); <( dC("(P0*b*k - b^2*k) - g - (-B*k + P0*k - b*k)*(b-B) >= 0", 1); <( dC("b - B >= 0", 1); <( dW(1); QE, hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="b <= P0"); hideL('L=="u*(1) <= B*(G*k)"); dbx("-B*k + P0*k - b*k", 1); doall(allR(1)*; implyR(1); andL('L)*; cohideOnlyL('L=="(P0*b*k - b^2*k) - g - (-B*k + P0*k - b*k)*(b-B) >= 0"); QE) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="B <= b"); hideL('L=="b <= P0"); hideL('L=="u*(1) <= B*(G*k)"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; cut("(-B*k + P0*k - b*k)*(b-B) = (P0*b*k - b^2*k) - (-B^2*k + B*P0*k)"); <( allL2R('Llast); QE, hideR(1); QE ) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="B <= b"); hideL('L=="b <= P0"); hideL('L=="u*(1) <= B*(G*k)"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="B <= b"); hideL('L=="b <= P0"); hideL('L=="u*(1) <= B*(G*k)"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="B <= b"); hideL('L=="b <= P0"); hideL('L=="u*(1) <= B*(G*k)"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), dI(1) ), dI(1) ), dbx("-b*k", 1) )
  )
End.
End.
