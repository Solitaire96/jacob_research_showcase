ArchiveEntry "ThmC-ii haldane: B <= b along every piecewise-constant strategy, cap Haldane V*B*G/(K+G+G^2/Ki)"
/* Generated by gen_caps.py.  Branch (ii) (c nondecreasing in G).  Ghost b is the greedy biomass,
   b' = h(b) = Y*c(b,(P0-b)/Y) = b*Nt(b)/Dt(b), polynomialized with r = 1/Dt(b); rB = 1/Dt(B) is a ghost for the
   cofactor's denominator.  Comparison: dbx on b - B with cofactor q = (h(b)-h(B))/(b-B) = Mt*r*rB (exact divided
   difference).  The cap constraint u <= c(B,G) is written u*Dn(G) <= B*N(G) (Dn > 0 on G >= 0).
   The postcondition exports the loop invariant (needed by the ghost-existence glue). */
ProgramVariables
  Real B; Real G; Real b; Real u; Real g; Real P0; Real r; Real rB; Real V; Real K; Real Ki; Real Y;
End.
Problem
  V>0 & K>0 & Ki>0 & Y>0
  & B >= 0 & G >= 0 & B + Y*G = P0 & b = B & r*(K*Ki*Y^2 + Ki*P0*Y - Ki*Y*b + P0^2 - 2*P0*b + b^2) = 1 & rB*(B^2 - B*Ki*Y - 2*B*P0 + K*Ki*Y^2 + Ki*P0*Y + P0^2) = 1
  ->
  [{ u := *; g := *; ?(0<=u & u*(G^2 + G*Ki + K*Ki) <= B*(G*Ki*V) & 0<=g & g<=Y*u);
     {B' = g, G' = -u, b' = Ki*P0*V*Y^2*b*r - Ki*V*Y^2*b^2*r, r' = Ki^2*P0*V*Y^3*b*r^3 - Ki^2*V*Y^3*b^2*r^3 + 2*Ki*P0^2*V*Y^2*b*r^3 - 4*Ki*P0*V*Y^2*b^2*r^3 + 2*Ki*V*Y^2*b^3*r^3, rB' = -2*B*g*rB^2 + Ki*Y*g*rB^2 + 2*P0*g*rB^2 & G>=0 & u*(G^2 + G*Ki + K*Ki) <= B*(G*Ki*V)}
   }*
  ] (B >= 0 & G >= 0 & B + Y*G <= P0 & B <= b & b <= P0 & r*(K*Ki*Y^2 + Ki*P0*Y - Ki*Y*b + P0^2 - 2*P0*b + b^2) = 1 & rB*(B^2 - B*Ki*Y - 2*B*P0 + K*Ki*Y^2 + Ki*P0*Y + P0^2) = 1)
End.
Tactic "dbx comparison (generated)"
  implyR(1); andL('L)*;
  loop("B >= 0 & G >= 0 & B + Y*G <= P0 & B <= b & b <= P0 & r*(K*Ki*Y^2 + Ki*P0*Y - Ki*Y*b + P0^2 - 2*P0*b + b^2) = 1 & rB*(B^2 - B*Ki*Y - 2*B*P0 + K*Ki*Y^2 + Ki*P0*Y + P0^2) = 1", 1); <(
    QE,
    QE,
    unfold;
    dC("r*(K*Ki*Y^2 + Ki*P0*Y - Ki*Y*b + P0^2 - 2*P0*b + b^2) - 1 = 0", 1); <( dC("rB*(B^2 - B*Ki*Y - 2*B*P0 + K*Ki*Y^2 + Ki*P0*Y + P0^2) - 1 = 0", 1); <( dC("P0 - b >= 0", 1); <( dC("B + Y*G <= P0", 1); <( dC("B >= 0", 1); <( dC("Y*u*(B^2 - B*Ki*Y - 2*B*P0 + K*Ki*Y^2 + Ki*P0*Y + P0^2) <= B*(-B*Ki*V*Y^2 + Ki*P0*V*Y^2)", 1); <( dC("g*(B^2 - B*Ki*Y - 2*B*P0 + K*Ki*Y^2 + Ki*P0*Y + P0^2) <= B*(-B*Ki*V*Y^2 + Ki*P0*V*Y^2)", 1); <( dC("rB*B*(-B*Ki*V*Y^2 + Ki*P0*V*Y^2) - g >= 0", 1); <( dC("(-B*K*Ki^2*V*Y^4*r*rB - B*Ki^2*P0*V*Y^3*r*rB + B*Ki^2*V*Y^3*b*r*rB - B*Ki*P0^2*V*Y^2*r*rB + B*Ki*P0*V*Y^2*b*r*rB + K*Ki^2*P0*V*Y^4*r*rB - K*Ki^2*V*Y^4*b*r*rB + Ki^2*P0^2*V*Y^3*r*rB - Ki^2*P0*V*Y^3*b*r*rB + Ki*P0^3*V*Y^2*r*rB - Ki*P0^2*V*Y^2*b*r*rB)*(b-B) - (Ki*P0*V*Y^2*b*r - Ki*V*Y^2*b^2*r) + rB*B*(-B*Ki*V*Y^2 + Ki*P0*V*Y^2) = 0", 1); <( dC("(Ki*P0*V*Y^2*b*r - Ki*V*Y^2*b^2*r) - g - (-B*K*Ki^2*V*Y^4*r*rB - B*Ki^2*P0*V*Y^3*r*rB + B*Ki^2*V*Y^3*b*r*rB - B*Ki*P0^2*V*Y^2*r*rB + B*Ki*P0*V*Y^2*b*r*rB + K*Ki^2*P0*V*Y^4*r*rB - K*Ki^2*V*Y^4*b*r*rB + Ki^2*P0^2*V*Y^3*r*rB - Ki^2*P0*V*Y^3*b*r*rB + Ki*P0^3*V*Y^2*r*rB - Ki*P0^2*V*Y^2*b*r*rB)*(b-B) >= 0", 1); <( dC("b - B >= 0", 1); <( dW(1); QE, hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="b <= P0"); hideL('L=="u*(G^2 + G*Ki + K*Ki) <= B*(G*Ki*V)"); hideL('L=="r*(K*Ki*Y^2 + Ki*P0*Y - Ki*Y*b + P0^2 - 2*P0*b + b^2) = 1"); hideL('L=="rB*(B^2 - B*Ki*Y - 2*B*P0 + K*Ki*Y^2 + Ki*P0*Y + P0^2) = 1"); dbx("-B*K*Ki^2*V*Y^4*r*rB - B*Ki^2*P0*V*Y^3*r*rB + B*Ki^2*V*Y^3*b*r*rB - B*Ki*P0^2*V*Y^2*r*rB + B*Ki*P0*V*Y^2*b*r*rB + K*Ki^2*P0*V*Y^4*r*rB - K*Ki^2*V*Y^4*b*r*rB + Ki^2*P0^2*V*Y^3*r*rB - Ki^2*P0*V*Y^3*b*r*rB + Ki*P0^3*V*Y^2*r*rB - Ki*P0^2*V*Y^2*b*r*rB", 1); doall(allR(1)*; implyR(1); andL('L)*; cohideOnlyL('L=="(Ki*P0*V*Y^2*b*r - Ki*V*Y^2*b^2*r) - g - (-B*K*Ki^2*V*Y^4*r*rB - B*Ki^2*P0*V*Y^3*r*rB + B*Ki^2*V*Y^3*b*r*rB - B*Ki*P0^2*V*Y^2*r*rB + B*Ki*P0*V*Y^2*b*r*rB + K*Ki^2*P0*V*Y^4*r*rB - K*Ki^2*V*Y^4*b*r*rB + Ki^2*P0^2*V*Y^3*r*rB - Ki^2*P0*V*Y^3*b*r*rB + Ki*P0^3*V*Y^2*r*rB - Ki*P0^2*V*Y^2*b*r*rB)*(b-B) >= 0"); QE) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="B <= b"); hideL('L=="b <= P0"); hideL('L=="u*(G^2 + G*Ki + K*Ki) <= B*(G*Ki*V)"); hideL('L=="r*(K*Ki*Y^2 + Ki*P0*Y - Ki*Y*b + P0^2 - 2*P0*b + b^2) = 1"); hideL('L=="rB*(B^2 - B*Ki*Y - 2*B*P0 + K*Ki*Y^2 + Ki*P0*Y + P0^2) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; cut("(-B*K*Ki^2*V*Y^4*r*rB - B*Ki^2*P0*V*Y^3*r*rB + B*Ki^2*V*Y^3*b*r*rB - B*Ki*P0^2*V*Y^2*r*rB + B*Ki*P0*V*Y^2*b*r*rB + K*Ki^2*P0*V*Y^4*r*rB - K*Ki^2*V*Y^4*b*r*rB + Ki^2*P0^2*V*Y^3*r*rB - Ki^2*P0*V*Y^3*b*r*rB + Ki*P0^3*V*Y^2*r*rB - Ki*P0^2*V*Y^2*b*r*rB)*(b-B) = (Ki*P0*V*Y^2*b*r - Ki*V*Y^2*b^2*r) - rB*B*(-B*Ki*V*Y^2 + Ki*P0*V*Y^2)"); <( allL2R('Llast); QE, hideR(1); QE ) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="B <= b"); hideL('L=="b <= P0"); hideL('L=="u*(G^2 + G*Ki + K*Ki) <= B*(G*Ki*V)"); hideL('L=="r*(K*Ki*Y^2 + Ki*P0*Y - Ki*Y*b + P0^2 - 2*P0*b + b^2) = 1"); hideL('L=="rB*(B^2 - B*Ki*Y - 2*B*P0 + K*Ki*Y^2 + Ki*P0*Y + P0^2) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; cut("(-B*K*Ki^2*V*Y^4*r*rB - B*Ki^2*P0*V*Y^3*r*rB + B*Ki^2*V*Y^3*b*r*rB - B*Ki*P0^2*V*Y^2*r*rB + B*Ki*P0*V*Y^2*b*r*rB + K*Ki^2*P0*V*Y^4*r*rB - K*Ki^2*V*Y^4*b*r*rB + Ki^2*P0^2*V*Y^3*r*rB - Ki^2*P0*V*Y^3*b*r*rB + Ki*P0^3*V*Y^2*r*rB - Ki*P0^2*V*Y^2*b*r*rB)*(b-B) - (Ki*P0*V*Y^2*b*r - Ki*V*Y^2*b^2*r) + rB*B*(-B*Ki*V*Y^2 + Ki*P0*V*Y^2) = (Ki*P0*V*Y^2*b*r - Ki*V*Y^2*b^2*r)*(rB*(B^2 - B*Ki*Y - 2*B*P0 + K*Ki*Y^2 + Ki*P0*Y + P0^2) - 1) - (-B^2*Ki*V*Y^2*rB + B*Ki*P0*V*Y^2*rB)*(r*(K*Ki*Y^2 + Ki*P0*Y - Ki*Y*b + P0^2 - 2*P0*b + b^2) - 1)"); <( cut("(Ki*P0*V*Y^2*b*r - Ki*V*Y^2*b^2*r)*(rB*(B^2 - B*Ki*Y - 2*B*P0 + K*Ki*Y^2 + Ki*P0*Y + P0^2) - 1) = 0"); <( cut("(-B^2*Ki*V*Y^2*rB + B*Ki*P0*V*Y^2*rB)*(r*(K*Ki*Y^2 + Ki*P0*Y - Ki*Y*b + P0^2 - 2*P0*b + b^2) - 1) = 0"); <( QE, hideR(1); QE ), hideR(1); QE ), hideR(1); QE ) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="B <= b"); hideL('L=="b <= P0"); hideL('L=="u*(G^2 + G*Ki + K*Ki) <= B*(G*Ki*V)"); hideL('L=="r*(K*Ki*Y^2 + Ki*P0*Y - Ki*Y*b + P0^2 - 2*P0*b + b^2) = 1"); hideL('L=="rB*(B^2 - B*Ki*Y - 2*B*P0 + K*Ki*Y^2 + Ki*P0*Y + P0^2) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="B <= b"); hideL('L=="b <= P0"); hideL('L=="u*(G^2 + G*Ki + K*Ki) <= B*(G*Ki*V)"); hideL('L=="r*(K*Ki*Y^2 + Ki*P0*Y - Ki*Y*b + P0^2 - 2*P0*b + b^2) = 1"); hideL('L=="rB*(B^2 - B*Ki*Y - 2*B*P0 + K*Ki*Y^2 + Ki*P0*Y + P0^2) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="B <= b"); hideL('L=="b <= P0"); hideL('L=="u*(G^2 + G*Ki + K*Ki) <= B*(G*Ki*V)"); hideL('L=="r*(K*Ki*Y^2 + Ki*P0*Y - Ki*Y*b + P0^2 - 2*P0*b + b^2) = 1"); hideL('L=="rB*(B^2 - B*Ki*Y - 2*B*P0 + K*Ki*Y^2 + Ki*P0*Y + P0^2) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), dI(1) ), dI(1) ), dbx("-Ki*V*Y^2*b*r", 1) ), dbx("-2*B*g*rB + Ki*Y*g*rB + 2*P0*g*rB", 1) ), dbx("Ki^2*P0*V*Y^3*b*r^2 - Ki^2*V*Y^3*b^2*r^2 + 2*Ki*P0^2*V*Y^2*b*r^2 - 4*Ki*P0*V*Y^2*b^2*r^2 + 2*Ki*V*Y^2*b^3*r^2", 1) )
  )
End.
End.
