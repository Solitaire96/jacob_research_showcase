ArchiveEntry "greedy-a admissible"
/* The greedy feedback u = c, g = Y*c stays admissible (G >= 0), stays on P = P0, and its biomass is the ghost b' = h(b).
   c(x,0) = 0 is stated in Hadamard form c(x,y) = dcg(x,y)*y (equivalent for smooth c), which gives the Darboux
   cofactor for G >= 0.  dh is the divided difference of h(x) = Y*c(x,(P0-x)/Y). */
Definitions
  Real c(Real x, Real y);
  Real dh(Real x, Real y);
  Real dcg(Real x, Real y);
  Real Y;
  Real P0;
End.
ProgramVariables
  Real B; Real G; Real b;
End.
Problem
  Y > 0
  & (\forall x \forall y (Y*c(x,(P0-x)/Y) - Y*c(y,(P0-y)/Y) = dh(x,y)*(x-y)))
  & (\forall x \forall y (c(x,y) = dcg(x,y)*y))
  & G >= 0 & B + Y*G = P0 & b = B
  ->
  [{B' = Y*c(B,G), G' = -c(B,G), b' = Y*c(b,(P0-b)/Y)}] (G >= 0 & B + Y*G = P0 & B = b)
End.
Tactic "manual"
  implyR(1); andL('L)*;
  dC("B + Y*G = P0", 1); <(
    dC("G >= 0", 1); <(
      dC("B - b = 0", 1); <(
        dW(1); QE,
        dbx("dh(B,b)", 1); allR(1)*; implyR(1); andL('L)*;
        cut("G = (P0-B)/Y"); <(
          allL2R('Llast); allL("B", -2); allL("b", -2); QE,
          hideR(1); QE
        )
      ),
      dbx("-dcg(B,G)", 1); allR(1)*; implyR(1); allL("B", -3); allL("G", -3); QE
    ),
    dI(1)
  )
End.
End.

ArchiveEntry "greedy-b global existence"
/* The 1-D greedy b' = h(b) exists for every horizon T >= 0 and stays in [0, P0].
   dBDG removes the ghost b (bounded by b^2 <= P0^2), leaving <t'=1> t = T.  Needs c(x,0) = 0 at x = P0 (so h(P0) = 0)
   and c(0, P0/Y) >= 0 (so h(0) >= 0). */
Definitions
  Real c(Real x, Real y);
  Real dh(Real x, Real y);
  Real Y;
  Real P0;
End.
ProgramVariables
  Real b; Real t; Real T;
End.
Problem
  Y > 0
  & (\forall x \forall y (Y*c(x,(P0-x)/Y) - Y*c(y,(P0-y)/Y) = dh(x,y)*(x-y)))
  & (\forall x \forall y (y = 0 -> c(x,y) = 0))
  & c(0,(P0-0)/Y) >= 0
  & 0 <= b & b <= P0 & t = 0 & T >= 0
  ->
  <{b' = Y*c(b,(P0-b)/Y), t' = 1}> t = T
End.
Tactic "manual"
  implyR(1); andL('L)*;
  dBDG("P0^2", 1); <(
    dC("P0 - b >= 0", 1); <(
      dC("b >= 0", 1); <(
        dW(1); QE,
        dbx("dh(b,0)", 1); allR(1)*; implyR(1); allL("b", -2); allL("0", -2); QE
      ),
      dbx("dh(b,P0)", 1); allR(1)*; allL("b", -2); allL("P0", -2); allL("P0", -3); allL("(P0-P0)/Y", -3); QE
    ),
    solve(1); QE
  )
End.
End.
