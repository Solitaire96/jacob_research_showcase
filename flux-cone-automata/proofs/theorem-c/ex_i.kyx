ArchiveEntry "ThmC-i ghost existence: adding the greedy-glucose ghost gam' = -phi(gam) never shortens a strategy segment"
/* dBDG with bound gam^2 <= (P0/Y)^2: along the product flow 0 <= gam <= G <= P0/Y (gam >= 0 needs phi(0) = c(P0,0) = 0;
   gam <= G is the branch-(i) comparison).  The ghost is the leading ODE, as dBDG in 5.1.2 requires. */
Definitions
  Real c(Real x, Real y);
  Real dphi(Real x, Real y);
  Real Y;
  Real P0;
End.
ProgramVariables
  Real B; Real G; Real gam; Real u; Real g; Real t; Real T;
End.
Problem
  Y > 0 & P0 >= 0
  & (\forall x1 \forall x2 \forall y (0<=x1 & x1<=x2 & y>=0 -> c(x1,y) <= c(x2,y)))
  & (\forall x \forall y (c(P0-Y*x,x) - c(P0-Y*y,y) = dphi(x,y)*(x-y)))
  & (\forall x \forall y (y = 0 -> c(x,y) = 0))
  & B >= 0 & G >= 0 & B + Y*G <= P0 & G >= gam & gam >= 0
  & 0<=u & 0<=g & g<=Y*u
  & <{B' = g, G' = -u, t' = 1 & G>=0 & u<=c(B,G)}> t = T
  ->
  <{gam' = -c(P0-Y*gam,gam), B' = g, G' = -u, t' = 1 & G>=0 & u<=c(B,G)}> t = T
End.
Tactic "manual"
  implyR(1); andL('L)*;
  dBDG("(P0/Y)^2", 1); <(
    hideL('Llast); dC("B + Y*G <= P0", 1); <(
      dC("B >= 0", 1); <(
        dC("G - gam >= 0", 1); <(
          dC("gam >= 0", 1); <(
            dW(1); QE,
            dbx("-dphi(gam,0)", 1); allR(1)*; implyR(1);
            allL("gam", -4); allL("0", -4); allL("P0-Y*0", -5); allL("0", -5); QE
          ),
          dbx("-dphi(G,gam)", 1); allR(1)*; implyR(1);
          allL("B", -3); allL("P0-Y*G", -3); allL("G", -3); allL("G", -4); allL("gam", -4); QE
        ),
        dI(1)
      ),
      dI(1)
    ),
    id
  )
End.
End.
