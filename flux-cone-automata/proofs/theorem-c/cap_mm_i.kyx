ArchiveEntry "ThmC-i mm: G >= gam, hence B <= P0 - Y*gam = b, along every piecewise-constant strategy, cap Michaelis-Menten V*B*G/(K+G)"
/* Generated by gen_caps.py.  Branch (i) (c nondecreasing in B), twin argument: u <= c(B,G) <= c(P0-Y*G, G) =: phi(G)
   because B <= P0 - Y*G (P <= P0).  Ghost gam is the greedy glucose, gam' = -phi(gam), polynomialized with
   s = 1/Dn(gam); sG = 1/Dn(G) is a ghost for the cofactor's denominator; greedy biomass is P0 - Y*gam.
   Comparison: dbx on G - gam with cofactor -(phi(G)-phi(gam))/(G-gam) = -Q*s*sG (exact divided difference). */
ProgramVariables
  Real B; Real G; Real gam; Real u; Real g; Real P0; Real s; Real sG; Real V; Real K; Real Y;
End.
Problem
  V>0 & K>0 & Y>0
  & B >= 0 & G >= 0 & B + Y*G = P0 & gam = G & s*(K + gam) = 1 & sG*(G + K) = 1
  ->
  [{ u := *; g := *; ?(0<=u & u*(G + K) <= B*(G*V) & 0<=g & g<=Y*u);
     {B' = g, G' = -u, gam' = -P0*V*gam*s + V*Y*gam^2*s, s' = P0*V*gam*s^3 - V*Y*gam^2*s^3, sG' = sG^2*u & G>=0 & u*(G + K) <= B*(G*V)}
   }*
  ] (B <= P0 - Y*gam & B >= 0 & G >= 0 & B + Y*G <= P0 & G >= gam & gam >= 0 & s*(K + gam) = 1 & sG*(G + K) = 1)
End.
Tactic "dbx comparison (generated)"
  implyR(1); andL('L)*;
  loop("B >= 0 & G >= 0 & B + Y*G <= P0 & G >= gam & gam >= 0 & s*(K + gam) = 1 & sG*(G + K) = 1", 1); <(
    QE,
    QE,
    unfold;
    dC("s*(K + gam) - 1 = 0", 1); <( dC("sG*(G + K) - 1 = 0", 1); <( dC("gam >= 0", 1); <( dC("B + Y*G <= P0", 1); <( dC("B >= 0", 1); <( dC("u*(G + K) <= (-G^2*V*Y + G*P0*V)", 1); <( dC("sG*(-G^2*V*Y + G*P0*V) - u >= 0", 1); <( dC("(G*K*V*Y*s*sG + G*V*Y*gam*s*sG - K*P0*V*s*sG + K*V*Y*gam*s*sG)*(G-gam) - (P0*V*gam*s - V*Y*gam^2*s) + sG*(-G^2*V*Y + G*P0*V) = 0", 1); <( dC("-u + (P0*V*gam*s - V*Y*gam^2*s) - (G*K*V*Y*s*sG + G*V*Y*gam*s*sG - K*P0*V*s*sG + K*V*Y*gam*s*sG)*(G-gam) >= 0", 1); <( dC("G - gam >= 0", 1); <( dW(1); QE, hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="gam >= 0"); hideL('L=="u*(G + K) <= B*(G*V)"); hideL('L=="s*(K + gam) = 1"); hideL('L=="sG*(G + K) = 1"); dbx("G*K*V*Y*s*sG + G*V*Y*gam*s*sG - K*P0*V*s*sG + K*V*Y*gam*s*sG", 1); doall(allR(1)*; implyR(1); andL('L)*; cohideOnlyL('L=="-u + (P0*V*gam*s - V*Y*gam^2*s) - (G*K*V*Y*s*sG + G*V*Y*gam*s*sG - K*P0*V*s*sG + K*V*Y*gam*s*sG)*(G-gam) >= 0"); QE) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="G >= gam"); hideL('L=="gam >= 0"); hideL('L=="u*(G + K) <= B*(G*V)"); hideL('L=="s*(K + gam) = 1"); hideL('L=="sG*(G + K) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; cut("(G*K*V*Y*s*sG + G*V*Y*gam*s*sG - K*P0*V*s*sG + K*V*Y*gam*s*sG)*(G-gam) = (P0*V*gam*s - V*Y*gam^2*s) - sG*(-G^2*V*Y + G*P0*V)"); <( allL2R('Llast); QE, hideR(1); QE ) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="G >= gam"); hideL('L=="gam >= 0"); hideL('L=="u*(G + K) <= B*(G*V)"); hideL('L=="s*(K + gam) = 1"); hideL('L=="sG*(G + K) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; cut("(G*K*V*Y*s*sG + G*V*Y*gam*s*sG - K*P0*V*s*sG + K*V*Y*gam*s*sG)*(G-gam) - (P0*V*gam*s - V*Y*gam^2*s) + sG*(-G^2*V*Y + G*P0*V) = -(-G^2*V*Y*sG + G*P0*V*sG)*(s*(K + gam) - 1) + (P0*V*gam*s - V*Y*gam^2*s)*(sG*(G + K) - 1)"); <( cut("(-G^2*V*Y*sG + G*P0*V*sG)*(s*(K + gam) - 1) = 0"); <( cut("(P0*V*gam*s - V*Y*gam^2*s)*(sG*(G + K) - 1) = 0"); <( QE, hideR(1); QE ), hideR(1); QE ), hideR(1); QE ) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="G >= gam"); hideL('L=="gam >= 0"); hideL('L=="u*(G + K) <= B*(G*V)"); hideL('L=="s*(K + gam) = 1"); hideL('L=="sG*(G + K) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="G >= gam"); hideL('L=="gam >= 0"); hideL('L=="u*(G + K) <= B*(G*V)"); hideL('L=="s*(K + gam) = 1"); hideL('L=="sG*(G + K) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), dI(1) ), dI(1) ), dbx("-P0*V*s + V*Y*gam*s", 1) ), dbx("sG*u", 1) ), dbx("P0*V*gam*s^2 - V*Y*gam^2*s^2", 1) )
  )
End.
End.
