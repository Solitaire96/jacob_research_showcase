ArchiveEntry "ThmC-ii ghost existence: adding the greedy ghost b' = h(b) never shortens a strategy segment"
/* dBDG (bounded differential ghost, Tan & Platzer): a ghost whose square stays below a bound p(x) of the
   other variables cannot cut a run short.  Here 0 <= B <= b <= P0 along the product flow, so b^2 <= P0^2.
   Needs c(x,0) = 0 (so h(P0) = 0 and b <= P0 is invariant). */
Definitions
  Real c(Real x, Real y);
  Real dh(Real x, Real y);
  Real Y;
  Real P0;
End.
ProgramVariables
  Real B; Real G; Real b; Real u; Real g; Real t; Real T;
End.
Problem
  Y > 0 & P0 >= 0
  & (\forall x \forall y1 \forall y2 (x>=0 & 0<=y1 & y1<=y2 -> c(x,y1) <= c(x,y2)))
  & (\forall x \forall y (Y*c(x,(P0-x)/Y) - Y*c(y,(P0-y)/Y) = dh(x,y)*(x-y)))
  & (\forall x \forall y (y = 0 -> c(x,y) = 0))
  & B >= 0 & G >= 0 & B + Y*G <= P0 & B <= b & b <= P0
  & 0<=u & 0<=g & g<=Y*u
  & <{B' = g, G' = -u, t' = 1 & G>=0 & u<=c(B,G)}> t = T
  ->
  <{b' = Y*c(b,(P0-b)/Y), B' = g, G' = -u, t' = 1 & G>=0 & u<=c(B,G)}> t = T
End.
Tactic "manual"
  implyR(1); andL('L)*;
  dBDG("P0^2", 1); <(
    hideL('Llast); dC("B + Y*G <= P0", 1); <(
      dC("B >= 0", 1); <(
        dC("b - B >= 0", 1); <(
          dC("P0 - b >= 0", 1); <(
            dW(1); QE,
            dbx("dh(b,P0)", 1); allR(1); allR(1); allR(1); implyR(1);
            allL("b", -4); allL("P0", -4); allL("P0", -5); allL("(P0-P0)/Y", -5); QE
          ),
          dbx("dh(b,B)", 1); allR(1); allR(1); allR(1); implyR(1);
          allL("B", -3); allL("G", -3); allL("(P0-B)/Y", -3); allL("b", -4); allL("B", -4); QE
        ),
        dI(1)
      ),
      dI(1)
    ),
    id
  )
End.
End.
