ArchiveEntry "ThmC-ii mm: B <= b along every piecewise-constant strategy, cap Michaelis-Menten V*B*G/(K+G)"
/* Generated by gen_caps.py.  Branch (ii) (c nondecreasing in G).  Ghost b is the greedy biomass,
   b' = h(b) = Y*c(b,(P0-b)/Y) = b*Nt(b)/Dt(b), polynomialized with r = 1/Dt(b); rB = 1/Dt(B) is a ghost for the
   cofactor's denominator.  Comparison: dbx on b - B with cofactor q = (h(b)-h(B))/(b-B) = Mt*r*rB (exact divided
   difference).  The cap constraint u <= c(B,G) is written u*Dn(G) <= B*N(G) (Dn > 0 on G >= 0).
   The postcondition exports the loop invariant (needed by the ghost-existence glue). */
ProgramVariables
  Real B; Real G; Real b; Real u; Real g; Real P0; Real r; Real rB; Real V; Real K; Real Y;
End.
Problem
  V>0 & K>0 & Y>0
  & B >= 0 & G >= 0 & B + Y*G = P0 & b = B & r*(K*Y + P0 - b) = 1 & rB*(-B + K*Y + P0) = 1
  ->
  [{ u := *; g := *; ?(0<=u & u*(G + K) <= B*(G*V) & 0<=g & g<=Y*u);
     {B' = g, G' = -u, b' = P0*V*Y*b*r - V*Y*b^2*r, r' = P0*V*Y*b*r^3 - V*Y*b^2*r^3, rB' = g*rB^2 & G>=0 & u*(G + K) <= B*(G*V)}
   }*
  ] (B >= 0 & G >= 0 & B + Y*G <= P0 & B <= b & b <= P0 & r*(K*Y + P0 - b) = 1 & rB*(-B + K*Y + P0) = 1)
End.
Tactic "dbx comparison (generated)"
  implyR(1); andL('L)*;
  loop("B >= 0 & G >= 0 & B + Y*G <= P0 & B <= b & b <= P0 & r*(K*Y + P0 - b) = 1 & rB*(-B + K*Y + P0) = 1", 1); <(
    QE,
    QE,
    unfold;
    dC("r*(K*Y + P0 - b) - 1 = 0", 1); <( dC("rB*(-B + K*Y + P0) - 1 = 0", 1); <( dC("P0 - b >= 0", 1); <( dC("B + Y*G <= P0", 1); <( dC("B >= 0", 1); <( dC("Y*u*(-B + K*Y + P0) <= B*(-B*V*Y + P0*V*Y)", 1); <( dC("g*(-B + K*Y + P0) <= B*(-B*V*Y + P0*V*Y)", 1); <( dC("rB*B*(-B*V*Y + P0*V*Y) - g >= 0", 1); <( dC("(-B*K*V*Y^2*r*rB - B*P0*V*Y*r*rB + B*V*Y*b*r*rB + K*P0*V*Y^2*r*rB - K*V*Y^2*b*r*rB + P0^2*V*Y*r*rB - P0*V*Y*b*r*rB)*(b-B) - (P0*V*Y*b*r - V*Y*b^2*r) + rB*B*(-B*V*Y + P0*V*Y) = 0", 1); <( dC("(P0*V*Y*b*r - V*Y*b^2*r) - g - (-B*K*V*Y^2*r*rB - B*P0*V*Y*r*rB + B*V*Y*b*r*rB + K*P0*V*Y^2*r*rB - K*V*Y^2*b*r*rB + P0^2*V*Y*r*rB - P0*V*Y*b*r*rB)*(b-B) >= 0", 1); <( dC("b - B >= 0", 1); <( dW(1); QE, hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="b <= P0"); hideL('L=="u*(G + K) <= B*(G*V)"); hideL('L=="r*(K*Y + P0 - b) = 1"); hideL('L=="rB*(-B + K*Y + P0) = 1"); dbx("-B*K*V*Y^2*r*rB - B*P0*V*Y*r*rB + B*V*Y*b*r*rB + K*P0*V*Y^2*r*rB - K*V*Y^2*b*r*rB + P0^2*V*Y*r*rB - P0*V*Y*b*r*rB", 1); doall(allR(1)*; implyR(1); andL('L)*; cohideOnlyL('L=="(P0*V*Y*b*r - V*Y*b^2*r) - g - (-B*K*V*Y^2*r*rB - B*P0*V*Y*r*rB + B*V*Y*b*r*rB + K*P0*V*Y^2*r*rB - K*V*Y^2*b*r*rB + P0^2*V*Y*r*rB - P0*V*Y*b*r*rB)*(b-B) >= 0"); QE) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="B <= b"); hideL('L=="b <= P0"); hideL('L=="u*(G + K) <= B*(G*V)"); hideL('L=="r*(K*Y + P0 - b) = 1"); hideL('L=="rB*(-B + K*Y + P0) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; cut("(-B*K*V*Y^2*r*rB - B*P0*V*Y*r*rB + B*V*Y*b*r*rB + K*P0*V*Y^2*r*rB - K*V*Y^2*b*r*rB + P0^2*V*Y*r*rB - P0*V*Y*b*r*rB)*(b-B) = (P0*V*Y*b*r - V*Y*b^2*r) - rB*B*(-B*V*Y + P0*V*Y)"); <( allL2R('Llast); QE, hideR(1); QE ) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="B <= b"); hideL('L=="b <= P0"); hideL('L=="u*(G + K) <= B*(G*V)"); hideL('L=="r*(K*Y + P0 - b) = 1"); hideL('L=="rB*(-B + K*Y + P0) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; cut("(-B*K*V*Y^2*r*rB - B*P0*V*Y*r*rB + B*V*Y*b*r*rB + K*P0*V*Y^2*r*rB - K*V*Y^2*b*r*rB + P0^2*V*Y*r*rB - P0*V*Y*b*r*rB)*(b-B) - (P0*V*Y*b*r - V*Y*b^2*r) + rB*B*(-B*V*Y + P0*V*Y) = (P0*V*Y*b*r - V*Y*b^2*r)*(rB*(-B + K*Y + P0) - 1) - (-B^2*V*Y*rB + B*P0*V*Y*rB)*(r*(K*Y + P0 - b) - 1)"); <( cut("(P0*V*Y*b*r - V*Y*b^2*r)*(rB*(-B + K*Y + P0) - 1) = 0"); <( cut("(-B^2*V*Y*rB + B*P0*V*Y*rB)*(r*(K*Y + P0 - b) - 1) = 0"); <( QE, hideR(1); QE ), hideR(1); QE ), hideR(1); QE ) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="B <= b"); hideL('L=="b <= P0"); hideL('L=="u*(G + K) <= B*(G*V)"); hideL('L=="r*(K*Y + P0 - b) = 1"); hideL('L=="rB*(-B + K*Y + P0) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="B <= b"); hideL('L=="b <= P0"); hideL('L=="u*(G + K) <= B*(G*V)"); hideL('L=="r*(K*Y + P0 - b) = 1"); hideL('L=="rB*(-B + K*Y + P0) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="B <= b"); hideL('L=="b <= P0"); hideL('L=="u*(G + K) <= B*(G*V)"); hideL('L=="r*(K*Y + P0 - b) = 1"); hideL('L=="rB*(-B + K*Y + P0) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), dI(1) ), dI(1) ), dbx("-V*Y*b*r", 1) ), dbx("g*rB", 1) ), dbx("P0*V*Y*b*r^2 - V*Y*b^2*r^2", 1) )
  )
End.
End.
