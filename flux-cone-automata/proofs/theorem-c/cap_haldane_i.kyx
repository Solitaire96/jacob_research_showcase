ArchiveEntry "ThmC-i haldane: G >= gam, hence B <= P0 - Y*gam = b, along every piecewise-constant strategy, cap Haldane V*B*G/(K+G+G^2/Ki)"
/* Generated by gen_caps.py.  Branch (i) (c nondecreasing in B), twin argument: u <= c(B,G) <= c(P0-Y*G, G) =: phi(G)
   because B <= P0 - Y*G (P <= P0).  Ghost gam is the greedy glucose, gam' = -phi(gam), polynomialized with
   s = 1/Dn(gam); sG = 1/Dn(G) is a ghost for the cofactor's denominator; greedy biomass is P0 - Y*gam.
   Comparison: dbx on G - gam with cofactor -(phi(G)-phi(gam))/(G-gam) = -Q*s*sG (exact divided difference). */
ProgramVariables
  Real B; Real G; Real gam; Real u; Real g; Real P0; Real s; Real sG; Real V; Real K; Real Ki; Real Y;
End.
Problem
  V>0 & K>0 & Ki>0 & Y>0
  & B >= 0 & G >= 0 & B + Y*G = P0 & gam = G & s*(K*Ki + Ki*gam + gam^2) = 1 & sG*(G^2 + G*Ki + K*Ki) = 1
  ->
  [{ u := *; g := *; ?(0<=u & u*(G^2 + G*Ki + K*Ki) <= B*(G*Ki*V) & 0<=g & g<=Y*u);
     {B' = g, G' = -u, gam' = -Ki*P0*V*gam*s + Ki*V*Y*gam^2*s, s' = Ki^2*P0*V*gam*s^3 - Ki^2*V*Y*gam^2*s^3 + 2*Ki*P0*V*gam^2*s^3 - 2*Ki*V*Y*gam^3*s^3, sG' = 2*G*sG^2*u + Ki*sG^2*u & G>=0 & u*(G^2 + G*Ki + K*Ki) <= B*(G*Ki*V)}
   }*
  ] (B <= P0 - Y*gam & B >= 0 & G >= 0 & B + Y*G <= P0 & G >= gam & gam >= 0 & s*(K*Ki + Ki*gam + gam^2) = 1 & sG*(G^2 + G*Ki + K*Ki) = 1)
End.
Tactic "dbx comparison (generated)"
  implyR(1); andL('L)*;
  loop("B >= 0 & G >= 0 & B + Y*G <= P0 & G >= gam & gam >= 0 & s*(K*Ki + Ki*gam + gam^2) = 1 & sG*(G^2 + G*Ki + K*Ki) = 1", 1); <(
    QE,
    QE,
    unfold;
    dC("s*(K*Ki + Ki*gam + gam^2) - 1 = 0", 1); <( dC("sG*(G^2 + G*Ki + K*Ki) - 1 = 0", 1); <( dC("gam >= 0", 1); <( dC("B + Y*G <= P0", 1); <( dC("B >= 0", 1); <( dC("u*(G^2 + G*Ki + K*Ki) <= (-G^2*Ki*V*Y + G*Ki*P0*V)", 1); <( dC("sG*(-G^2*Ki*V*Y + G*Ki*P0*V) - u >= 0", 1); <( dC("(G*K*Ki^2*V*Y*s*sG + G*Ki^2*V*Y*gam*s*sG + G*Ki*P0*V*gam*s*sG - K*Ki^2*P0*V*s*sG + K*Ki^2*V*Y*gam*s*sG)*(G-gam) - (Ki*P0*V*gam*s - Ki*V*Y*gam^2*s) + sG*(-G^2*Ki*V*Y + G*Ki*P0*V) = 0", 1); <( dC("-u + (Ki*P0*V*gam*s - Ki*V*Y*gam^2*s) - (G*K*Ki^2*V*Y*s*sG + G*Ki^2*V*Y*gam*s*sG + G*Ki*P0*V*gam*s*sG - K*Ki^2*P0*V*s*sG + K*Ki^2*V*Y*gam*s*sG)*(G-gam) >= 0", 1); <( dC("G - gam >= 0", 1); <( dW(1); QE, hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="gam >= 0"); hideL('L=="u*(G^2 + G*Ki + K*Ki) <= B*(G*Ki*V)"); hideL('L=="s*(K*Ki + Ki*gam + gam^2) = 1"); hideL('L=="sG*(G^2 + G*Ki + K*Ki) = 1"); dbx("G*K*Ki^2*V*Y*s*sG + G*Ki^2*V*Y*gam*s*sG + G*Ki*P0*V*gam*s*sG - K*Ki^2*P0*V*s*sG + K*Ki^2*V*Y*gam*s*sG", 1); doall(allR(1)*; implyR(1); andL('L)*; cohideOnlyL('L=="-u + (Ki*P0*V*gam*s - Ki*V*Y*gam^2*s) - (G*K*Ki^2*V*Y*s*sG + G*Ki^2*V*Y*gam*s*sG + G*Ki*P0*V*gam*s*sG - K*Ki^2*P0*V*s*sG + K*Ki^2*V*Y*gam*s*sG)*(G-gam) >= 0"); QE) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="G >= gam"); hideL('L=="gam >= 0"); hideL('L=="u*(G^2 + G*Ki + K*Ki) <= B*(G*Ki*V)"); hideL('L=="s*(K*Ki + Ki*gam + gam^2) = 1"); hideL('L=="sG*(G^2 + G*Ki + K*Ki) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; cut("(G*K*Ki^2*V*Y*s*sG + G*Ki^2*V*Y*gam*s*sG + G*Ki*P0*V*gam*s*sG - K*Ki^2*P0*V*s*sG + K*Ki^2*V*Y*gam*s*sG)*(G-gam) = (Ki*P0*V*gam*s - Ki*V*Y*gam^2*s) - sG*(-G^2*Ki*V*Y + G*Ki*P0*V)"); <( allL2R('Llast); QE, hideR(1); QE ) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="G >= gam"); hideL('L=="gam >= 0"); hideL('L=="u*(G^2 + G*Ki + K*Ki) <= B*(G*Ki*V)"); hideL('L=="s*(K*Ki + Ki*gam + gam^2) = 1"); hideL('L=="sG*(G^2 + G*Ki + K*Ki) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; cut("(G*K*Ki^2*V*Y*s*sG + G*Ki^2*V*Y*gam*s*sG + G*Ki*P0*V*gam*s*sG - K*Ki^2*P0*V*s*sG + K*Ki^2*V*Y*gam*s*sG)*(G-gam) - (Ki*P0*V*gam*s - Ki*V*Y*gam^2*s) + sG*(-G^2*Ki*V*Y + G*Ki*P0*V) = -(-G^2*Ki*V*Y*sG + G*Ki*P0*V*sG)*(s*(K*Ki + Ki*gam + gam^2) - 1) + (Ki*P0*V*gam*s - Ki*V*Y*gam^2*s)*(sG*(G^2 + G*Ki + K*Ki) - 1)"); <( cut("(-G^2*Ki*V*Y*sG + G*Ki*P0*V*sG)*(s*(K*Ki + Ki*gam + gam^2) - 1) = 0"); <( cut("(Ki*P0*V*gam*s - Ki*V*Y*gam^2*s)*(sG*(G^2 + G*Ki + K*Ki) - 1) = 0"); <( QE, hideR(1); QE ), hideR(1); QE ), hideR(1); QE ) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="G >= gam"); hideL('L=="gam >= 0"); hideL('L=="u*(G^2 + G*Ki + K*Ki) <= B*(G*Ki*V)"); hideL('L=="s*(K*Ki + Ki*gam + gam^2) = 1"); hideL('L=="sG*(G^2 + G*Ki + K*Ki) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="G >= gam"); hideL('L=="gam >= 0"); hideL('L=="u*(G^2 + G*Ki + K*Ki) <= B*(G*Ki*V)"); hideL('L=="s*(K*Ki + Ki*gam + gam^2) = 1"); hideL('L=="sG*(G^2 + G*Ki + K*Ki) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), dI(1) ), dI(1) ), dbx("-Ki*P0*V*s + Ki*V*Y*gam*s", 1) ), dbx("2*G*sG*u + Ki*sG*u", 1) ), dbx("Ki^2*P0*V*gam*s^2 - Ki^2*V*Y*gam^2*s^2 + 2*Ki*P0*V*gam^2*s^2 - 2*Ki*V*Y*gam^3*s^2", 1) )
  )
End.
End.
