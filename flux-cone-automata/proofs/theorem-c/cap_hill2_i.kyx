ArchiveEntry "ThmC-i hill2: G >= gam, hence B <= P0 - Y*gam = b, along every piecewise-constant strategy, cap Hill n=2 V*B*G^2/(K^2+G^2)"
/* Generated by gen_caps.py.  Branch (i) (c nondecreasing in B), twin argument: u <= c(B,G) <= c(P0-Y*G, G) =: phi(G)
   because B <= P0 - Y*G (P <= P0).  Ghost gam is the greedy glucose, gam' = -phi(gam), polynomialized with
   s = 1/Dn(gam); sG = 1/Dn(G) is a ghost for the cofactor's denominator; greedy biomass is P0 - Y*gam.
   Comparison: dbx on G - gam with cofactor -(phi(G)-phi(gam))/(G-gam) = -Q*s*sG (exact divided difference). */
ProgramVariables
  Real B; Real G; Real gam; Real u; Real g; Real P0; Real s; Real sG; Real V; Real K; Real Y;
End.
Problem
  V>0 & K>0 & Y>0
  & B >= 0 & G >= 0 & B + Y*G = P0 & gam = G & s*(K^2 + gam^2) = 1 & sG*(G^2 + K^2) = 1
  ->
  [{ u := *; g := *; ?(0<=u & u*(G^2 + K^2) <= B*(G^2*V) & 0<=g & g<=Y*u);
     {B' = g, G' = -u, gam' = -P0*V*gam^2*s + V*Y*gam^3*s, s' = 2*P0*V*gam^3*s^3 - 2*V*Y*gam^4*s^3, sG' = 2*G*sG^2*u & G>=0 & u*(G^2 + K^2) <= B*(G^2*V)}
   }*
  ] (B <= P0 - Y*gam & B >= 0 & G >= 0 & B + Y*G <= P0 & G >= gam & gam >= 0 & s*(K^2 + gam^2) = 1 & sG*(G^2 + K^2) = 1)
End.
Tactic "dbx comparison (generated)"
  implyR(1); andL('L)*;
  loop("B >= 0 & G >= 0 & B + Y*G <= P0 & G >= gam & gam >= 0 & s*(K^2 + gam^2) = 1 & sG*(G^2 + K^2) = 1", 1); <(
    QE,
    QE,
    unfold;
    dC("s*(K^2 + gam^2) - 1 = 0", 1); <( dC("sG*(G^2 + K^2) - 1 = 0", 1); <( dC("gam >= 0", 1); <( dC("B + Y*G <= P0", 1); <( dC("B >= 0", 1); <( dC("u*(G^2 + K^2) <= (-G^3*V*Y + G^2*P0*V)", 1); <( dC("sG*(-G^3*V*Y + G^2*P0*V) - u >= 0", 1); <( dC("(G^2*K^2*V*Y*s*sG + G^2*V*Y*gam^2*s*sG - G*K^2*P0*V*s*sG + G*K^2*V*Y*gam*s*sG - K^2*P0*V*gam*s*sG + K^2*V*Y*gam^2*s*sG)*(G-gam) - (P0*V*gam^2*s - V*Y*gam^3*s) + sG*(-G^3*V*Y + G^2*P0*V) = 0", 1); <( dC("-u + (P0*V*gam^2*s - V*Y*gam^3*s) - (G^2*K^2*V*Y*s*sG + G^2*V*Y*gam^2*s*sG - G*K^2*P0*V*s*sG + G*K^2*V*Y*gam*s*sG - K^2*P0*V*gam*s*sG + K^2*V*Y*gam^2*s*sG)*(G-gam) >= 0", 1); <( dC("G - gam >= 0", 1); <( dW(1); QE, hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="gam >= 0"); hideL('L=="u*(G^2 + K^2) <= B*(G^2*V)"); hideL('L=="s*(K^2 + gam^2) = 1"); hideL('L=="sG*(G^2 + K^2) = 1"); dbx("G^2*K^2*V*Y*s*sG + G^2*V*Y*gam^2*s*sG - G*K^2*P0*V*s*sG + G*K^2*V*Y*gam*s*sG - K^2*P0*V*gam*s*sG + K^2*V*Y*gam^2*s*sG", 1); doall(allR(1)*; implyR(1); andL('L)*; cohideOnlyL('L=="-u + (P0*V*gam^2*s - V*Y*gam^3*s) - (G^2*K^2*V*Y*s*sG + G^2*V*Y*gam^2*s*sG - G*K^2*P0*V*s*sG + G*K^2*V*Y*gam*s*sG - K^2*P0*V*gam*s*sG + K^2*V*Y*gam^2*s*sG)*(G-gam) >= 0"); QE) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="G >= gam"); hideL('L=="gam >= 0"); hideL('L=="u*(G^2 + K^2) <= B*(G^2*V)"); hideL('L=="s*(K^2 + gam^2) = 1"); hideL('L=="sG*(G^2 + K^2) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; cut("(G^2*K^2*V*Y*s*sG + G^2*V*Y*gam^2*s*sG - G*K^2*P0*V*s*sG + G*K^2*V*Y*gam*s*sG - K^2*P0*V*gam*s*sG + K^2*V*Y*gam^2*s*sG)*(G-gam) = (P0*V*gam^2*s - V*Y*gam^3*s) - sG*(-G^3*V*Y + G^2*P0*V)"); <( allL2R('Llast); QE, hideR(1); QE ) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="G >= gam"); hideL('L=="gam >= 0"); hideL('L=="u*(G^2 + K^2) <= B*(G^2*V)"); hideL('L=="s*(K^2 + gam^2) = 1"); hideL('L=="sG*(G^2 + K^2) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; cut("(G^2*K^2*V*Y*s*sG + G^2*V*Y*gam^2*s*sG - G*K^2*P0*V*s*sG + G*K^2*V*Y*gam*s*sG - K^2*P0*V*gam*s*sG + K^2*V*Y*gam^2*s*sG)*(G-gam) - (P0*V*gam^2*s - V*Y*gam^3*s) + sG*(-G^3*V*Y + G^2*P0*V) = -(-G^3*V*Y*sG + G^2*P0*V*sG)*(s*(K^2 + gam^2) - 1) + (P0*V*gam^2*s - V*Y*gam^3*s)*(sG*(G^2 + K^2) - 1)"); <( cut("(-G^3*V*Y*sG + G^2*P0*V*sG)*(s*(K^2 + gam^2) - 1) = 0"); <( cut("(P0*V*gam^2*s - V*Y*gam^3*s)*(sG*(G^2 + K^2) - 1) = 0"); <( QE, hideR(1); QE ), hideR(1); QE ), hideR(1); QE ) ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="G >= gam"); hideL('L=="gam >= 0"); hideL('L=="u*(G^2 + K^2) <= B*(G^2*V)"); hideL('L=="s*(K^2 + gam^2) = 1"); hideL('L=="sG*(G^2 + K^2) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), hideL('L=="B >= 0"); hideL('L=="G >= 0"); hideL('L=="B + Y*G <= P0"); hideL('L=="G >= gam"); hideL('L=="gam >= 0"); hideL('L=="u*(G^2 + K^2) <= B*(G^2*V)"); hideL('L=="s*(K^2 + gam^2) = 1"); hideL('L=="sG*(G^2 + K^2) = 1"); dWplus(1); (allR(1))*; (implyR(1))*; andL('L)*; QE ), dI(1) ), dI(1) ), dbx("-P0*V*gam*s + V*Y*gam^2*s", 1) ), dbx("2*G*sG*u", 1) ), dbx("2*P0*V*gam^3*s^2 - 2*V*Y*gam^4*s^2", 1) )
  )
End.
End.
