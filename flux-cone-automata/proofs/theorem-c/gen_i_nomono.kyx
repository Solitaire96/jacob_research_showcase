ArchiveEntry "NEGATIVE CONTROL (expected FAILED) ThmC-i generic WITHOUT monotonicity in B: comparison G >= gamma, hence B <= P0 - Y*gamma = b, for every piecewise-constant strategy (c smooth, nondecreasing in B)"
/* Branch (i) without an explicit twin variable: the twin's admissibility u <= c(B,G) <= c(P0 - Y*G, G)
   follows from B <= P0 - Y*G, i.e. from P <= P0.  gam is the greedy glucose (greedy B is P0 - Y*gam). */
Definitions
  Real c(Real x, Real y);
  Real dphi(Real x, Real y);
  Real Y;
  Real P0;
End.
ProgramVariables
  Real B; Real G; Real gam; Real u; Real g;
End.
Problem
  Y > 0
  & (\forall x \forall y (c(P0-Y*x,x) - c(P0-Y*y,y) = dphi(x,y)*(x-y)))
  & B >= 0 & G >= 0 & B + Y*G = P0 & gam = G
  ->
  [{ u := *; g := *; ?(0<=u & u<=c(B,G) & 0<=g & g<=Y*u);
     {B' = g, G' = -u, gam' = -c(P0-Y*gam,gam) & G>=0 & u<=c(B,G)}
   }*@invariant(B >= 0 & G >= 0 & B + Y*G <= P0 & G >= gam)
  ] B <= P0 - Y*gam
End.
Tactic "manual"
  implyR(1); andL('L)*;
  loop("B >= 0 & G >= 0 & B + Y*G <= P0 & G >= gam", 1); <(
    QE,
    QE,
    unfold;
    dC("B + Y*G <= P0", 1); <(
      dC("B >= 0", 1); <(
        dC("G - gam >= 0", 1); <(
          dW(1); QE,
          dbx("-dphi(G,gam)", 1); allR(1); allR(1); allR(1); implyR(1);
          allL("G", -2); allL("gam", -2); QE
        ),
        dI(1)
      ),
      dI(1)
    )
  )
End.
End.
