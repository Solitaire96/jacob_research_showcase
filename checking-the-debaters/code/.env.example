# ── Backend: set ONE key (or force with LLM_BACKEND=cerebras|anthropic|gemini) ──
# Priority when LLM_BACKEND is unset: Cerebras → Anthropic → Gemini.
# CEREBRAS_API_KEY=your_cerebras_key_here
# CEREBRAS_MODEL=gpt-oss-120b
# CEREBRAS_TIER=free             # free (65k context, 5 req/min, 1M tokens/day) | paid (131k context)
# CEREBRAS_REASONING_EFFORT=medium
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_API_KEY=your_google_api_key_here

# ── Optional Overrides ─────────────────────────────────────────────────────────
# Default: gemini-2.5-pro
# GEMINI_MODEL=gemini-2.5-pro

# Default: ./output/reports
# OUTPUT_DIR=./output/reports

# ── For Sentiment Agent live web search (optional) ─────────────────────────────
# Google Programmable Search engine ID. Without it, the Sentiment Agent scores
# external-signal dimensions N/A instead of guessing.
# GOOGLE_CSE_ID=your_custom_search_engine_id
# GOOGLE_API_KEY is reused for search — same key as above

# ── Tuning (optional) ──────────────────────────────────────────────────────────
# MAX_DOC_CHARS=               # documents sent with every call; default depends on backend/tier
# MAX_TRANSCRIPT_CHARS=        # debate transcript per prompt; default depends on backend/tier
# MAX_OUTPUT_TOKENS=           # per call (includes reasoning tokens on Cerebras)
# PARALLEL_WORKERS=            # concurrent independent calls per phase (default 1 on Cerebras free, else 6)
# DOC_COMPRESSION=1             # local compression before sending (0 = off; or --no-compress)
# RISK_BLOCK_ON_UNRESOLVED=1    # Risk INVEST with an UNRESOLVED objection → PASS

# ── Experiments (normally set by experiments/run.py, not here) ─────────────────
# ABLATION=E                    # A–E; E = full system (see experiments/README.md)
# SOCRATIC_REFEREE=1            # 0 = no Socratic audit/rebuttals in Phase 3
# RATE_LIMIT_MAX_RETRIES=10     # HTTP 429 retries per call
# RATE_LIMIT_MAX_WAIT_S=90      # max wait per retry
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# ── Fact ledger & deal math (Phase 0) ──────────────────────────────────────────
# FACT_LEDGER=1                 # 0 = skip the ledger and deal math
# DILUTION_PER_ROUND=0.20       # [A] dilution per future round
# FUTURE_ROUNDS=2               # [A] rounds between entry and exit
# EXIT_REVENUE_MULTIPLES=3,5,10 # [A] exit value = revenue × multiple
# MOIC_TARGETS=10,30,100        # exit value required for these multiples
